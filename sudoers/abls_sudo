## Allows the group abls to execute these commands
%abls  ALL=(ALL) NOPASSWD: /usr/bin/apt update -y
%abls  ALL=(ALL) NOPASSWD: /usr/bin/apt upgrade -y
%abls  ALL=(ALL) NOPASSWD: /usr/sbin/dnf upgrade -y
%abls  ALL=(ALL) NOPASSWD: /usr/sbin/poweroff
%abls  ALL=(ALL) NOPASSWD: /usr/sbin/reboot
## Command for Agents
%abls ALL=(ALL) NOPASSWD: /usr/bin/apt ^install -y abls-[A-Za-z0-9-]+$
%abls ALL=(ALL) NOPASSWD: /usr/bin/apt ^upgrade -y abls-[A-Za-z0-9-]+$
%abls ALL=(ALL) NOPASSWD: /usr/sbin/dnf ^install -y abls-[A-Za-z0-9-]+$
%abls ALL=(ALL) NOPASSWD: /usr/sbin/dnf ^upgrade -y abls-[A-Za-z0-9-]+$
%abls ALL=(ALL) NOPASSWD: /usr/bin/systemctl ^stop abls-[A-Za-z0-9@.-]+$
%abls ALL=(ALL) NOPASSWD: /usr/bin/systemctl ^start abls-[A-Za-z0-9@.-]+$
%abls ALL=(ALL) NOPASSWD: /usr/bin/systemctl ^restart abls-[A-Za-z0-9@.-]+$
%abls ALL=(ALL) NOPASSWD: /usr/bin/systemctl ^enable abls-[A-Za-z0-9@.-]+$
%abls ALL=(ALL) NOPASSWD: /usr/bin/systemctl ^disable abls-[A-Za-z0-9@.-]+$

%abls ALL=(ALL) NOPASSWD: /usr/bin/systemctl --user ^stop abls-[A-Za-z0-9@.-]+$
%abls ALL=(ALL) NOPASSWD: /usr/bin/systemctl --user ^start abls-[A-Za-z0-9@.-]+$
%abls ALL=(ALL) NOPASSWD: /usr/bin/systemctl --user ^restart abls-[A-Za-z0-9@.-]+$
%abls ALL=(ALL) NOPASSWD: /usr/bin/systemctl --user ^enable abls-[A-Za-z0-9@.-]+$
%abls ALL=(ALL) NOPASSWD: /usr/bin/systemctl --user ^disable abls-[A-Za-z0-9@.-]+$

Defaults:%abls !requiretty